{
  "name": "steward-v3",
  "version": "5.0.0",
  "description": "Steward - Command launcher (Manifest V3)",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "prod": "npm run build && node scripts/pack.mjs",
    "preview": "vite preview",
    "docs:dev": "pnpm exec vitepress dev docs-website",
    "docs:build": "pnpm exec vitepress build docs-website",
    "docs:preview": "pnpm exec vitepress preview docs-website"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "daisyui": "^4.4.19"
  },
  "devDependencies": {
    "@samrum/vite-plugin-web-extension": "^5.1.1",
    "vitepress": "^1.0.0",
    "@types/chrome": "^0.0.254",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^6.4.2"
  }
}
